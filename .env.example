# Copy this file to `.env` and fill in values. Never commit `.env`.

# --- Supabase (required for the app) ---
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-side / scripts only — do not ship the service role key in the Flutter client.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- NVIDIA (e.g. AI features) ---
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_MODEL=YOUR_NVIDIA_MODEL_NAME

# --- App ---
APP_ENV=development
API_TIMEOUT=10000

# --- OAuth & password-reset deep links (add to your `.env`; required at startup) ---
# Copy the two lines below into `.env` (uncomment there). Values must match what you allowlist in
# Supabase → Authentication → URL Configuration → Redirect URLs (same strings, character for character).
#
# OAUTH_REDIRECT_URL=com.acadia.app://auth-callback
# PASSWORD_RESET_REDIRECT_URL=com.acadia.app://reset-password
#
# Same scheme must match Android/iOS URL scheme (`com.acadia.app`) and your Supabase Google/Apple OAuth setup.

# --- Flutter web only (optional): OAuth return after provider login ---
# If unset on web, the app uses the current origin (e.g. http://localhost:XXXX/).
# Add whatever you use here to Supabase redirect URLs (and Google Web client if needed).
# WEB_OAUTH_REDIRECT_URL=https://your-deployed-app.example/

# --- Google OAuth (IMPORTANT) ---
# Put the Web application Client ID + Client Secret in Supabase Dashboard only:
#   Authentication → Providers → Google
# Do NOT put GOOGLE_CLIENT_SECRET in this file or in Flutter code — it must stay server-side.

# Optional: public Web Client ID (same ID as in Supabase Google provider) if you add native Google Sign-In later.
# GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
